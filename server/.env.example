# ===== Render 后台 → Web Service → Environment =====
# 必填只有下面 5 项，全部来自 Aiven PostgreSQL 服务详情页
# （Service URI / Connection info 里的 Host / Port / User / Password / Database）
# 注意：Aiven 建服务时选 PostgreSQL + "Free" plan，无需信用卡、永久免费。

DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASS=your-aiven-password
DB_NAME=defaultdb

# ===== 驱动（可选项，默认就是 postgres，通常不用填）=====
# 若以后改回 MySQL，才设 DB_DRIVER=mysql
# DB_DRIVER=postgres

# ===== 以下两项「可选项」，通常直接留空 / 不填 =====
# Aiven 强制 TLS，后端已默认「开启加密但不校验证书」，因此 DB_CA 不是必填。
# 只有在你希望严格校验证书时，才把 Aiven 的 CA 全文（含 BEGIN/END 行）粘进来。
# DB_CA=
#
# DB_SSL 不要设成 false —— 关闭 TLS 会导致 Aiven 拒绝连接。
# 填 true 或干脆不填都可以。
# DB_SSL=true

# ===== 不用做的事 =====
# · 不用执行 schema.sql：后端首次访问 /api 时会自动 CREATE TABLE IF NOT EXISTS。
# · 不用填 API 地址：前端与后端同源部署，config.js 的 apiBase 保持空即可。

# 以下由 Render 自动注入，不用手填
# PORT=3000
