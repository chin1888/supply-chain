# 复制以下 6 项到 Render 后台 → 你的 Web Service → Environment
# 值全部来自 Aiven MySQL 服务详情页（Host / Port / User / Password / Database）

DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASS=your-aiven-password
DB_NAME=defaultdb

# Aiven 强制 TLS：把 Aiven 提供的 CA 证书全文粘进来（含 -----BEGIN CERTIFICATE----- 整段）
# 临时测试可设 DB_SSL=false 宽松放行（不建议生产）
DB_CA=
DB_SSL=true

# 以下由 Render 自动注入，不用手填
# PORT=3000
